# Copy this file to .env.local (gitignored) to raise the GitHub Analytics
# section's rate limit from 60/hr to 5000/hr while running `npm run dev`.
#
# Create a token at: https://github.com/settings/tokens
# "Generate new token (classic)" — no scopes needed, this only reads public data.
#
# This variable is unused in the production build (which uses the server-side
# api/gh.ts proxy + GITHUB_TOKEN instead), so it's safe to keep locally.
VITE_GITHUB_TOKEN=

# Contact form — get a free access key at https://web3forms.com (just enter
# your email, no account/signup needed, key arrives instantly by email).
# Messages submitted on /contact are emailed straight to that address.
# This same key is used in both dev and production (set it in Vercel too).
VITE_WEB3FORMS_KEY=
